# worker/.env — this service's own values only (gitignored).
# Twitter (X_*) and OPENAI_API_KEY are NOT copied here: env.mjs reads them from
# clawd-twitter's .env (TWITTER_ENV_FILE overrides the path).

# The deployed site, and the shared secret its /api/worker/* routes expect
# (same value as the Vercel env WORKER_SECRET).
API_BASE=https://burn-to-tweet.vercel.app
WORKER_SECRET=

# Which subscription login bills clawd's turns (a ~/.clawd-accounts/<name> dir).
AGENT_CLAUDE_CONFIG_DIR=/Users/clawd/.clawd-accounts/ef

# Optional
# AGENT_MODEL=claude-opus-5-5
# IMAGE_MODEL=gpt-image-2
# WORKER_CONCURRENCY=3
# IDLE_POLL_MS=20000
# DRY_RUN_POST=1          # never post to X; fake tweet URLs (local testing)
